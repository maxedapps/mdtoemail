{
  "name": "mdtoemail",
  "version": "0.1.0",
  "description": "Fast Markdown to conservative email-friendly HTML converter",
  "type": "module",
  "bin": {
    "mdtoemail": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist",
    "compile": "bun build ./src/cli.ts --compile --outfile dist/mdtoemail"
  },
  "dependencies": {
    "satteri": "0.9.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
