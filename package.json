{
  "name": "mdtoemail",
  "version": "0.1.0",
  "description": "Fast Markdown to conservative email-friendly HTML converter",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdtoemail": "./src/cli.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "mdtoemail.example.toml"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "satteri": "0.9.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "parse5": "8.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
