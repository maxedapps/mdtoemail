{
  "name": "mdtoemail",
  "version": "0.2.0",
  "description": "Fast Markdown to conservative email-friendly HTML converter",
  "keywords": [
    "markdown",
    "email",
    "html",
    "cli",
    "bun",
    "newsletter",
    "transactional-email"
  ],
  "homepage": "https://github.com/maxedapps/mdtoemail#readme",
  "bugs": {
    "url": "https://github.com/maxedapps/mdtoemail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxedapps/mdtoemail.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mdtoemail": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "mdtoemail.example.toml"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "rm -rf dist && bunx tsc -p tsconfig.build.json && bun build ./src/cli.ts --target=bun --outdir=dist",
    "prepack": "bun run build",
    "test:candidate": "bun run test/package-candidate.ts"
  },
  "dependencies": {
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "parse5": "8.0.1",
    "typescript": "^6.0.3",
    "wrangler": "4.123.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14"
}
